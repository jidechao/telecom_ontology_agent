# ============================================================
# 配置模板：复制为 .env 后填入真实值（.env 已被 .gitignore 排除，不会入库）
# 也支持 OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL 命名
# ============================================================

# DeepSeek（OpenAI 兼容端点）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 或使用 OpenAI 命名（二选一，agent.py 会自动兼容）
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 可选：显式指定 .env 文件路径（优先于项目内 .env）
# ENV_FILE=C:\path\to\your\.env
